# ===========================================
# IEYDA Website - Production Environment
# ===========================================
# Copy this file to .env on your production server
# Fill in your actual production values
# ===========================================

APP_NAME="IEYDA CMS"
APP_ENV=production
APP_KEY=base64:w2BZHQI3NwaxyJIXlXnLs07pwqMrvko6fTpXA+7TAgk=
APP_DEBUG=false
APP_URL=https://control.ilorinemirateyouths.com

# ===========================================
# Database Configuration
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ieyda_cms_production
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# Cache & Session
# ===========================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ===========================================
# Redis (Optional - for better performance)
# ===========================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply.ieyda@gmail.com
MAIL_PASSWORD=gddaihsfbopgtmnn
MAIL_FROM_ADDRESS=noreply.ieyda@gmail.com
MAIL_FROM_NAME="IEYDA CMS"

# ===========================================
# AWS S3 (Optional - for file storage)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# Pusher (for real-time features)
# ===========================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ===========================================
# SMS Configuration
# ===========================================
SMS_PROVIDER=termii
SMS_FROM=IEYDA

# Termii Settings
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=IEYDA
TERMII_BASE_URL=https://api.ng.termii.com

# Twilio Settings (Alternative)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ===========================================
# Webhook Security
# ===========================================
LEAD_WEBHOOK_TOKEN=DE3mVABpPljuqGamwZ1o4uXepXbMWtna

# ===========================================
# Payment Gateway (Paystack)
# ===========================================
# IMPORTANT: Use LIVE keys for production, not test keys!
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here

# ===========================================
# Google Form Integration
# ===========================================
GOOGLE_FORM_URL=https://forms.gle/Acvv2bSX8Hom5JHQ6

# ===========================================
# Facebook Integration
# ===========================================
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=

# ===========================================
# Frontend API URL (for Vite build)
# ===========================================
VITE_API_URL=https://control.ilorinemirateyouths.com/api/v1

